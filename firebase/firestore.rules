rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validUserCreate(userId) {
      return request.resource.data.userId == userId &&
        request.resource.data.email is string &&
        request.resource.data.isVerifiedBuyer == false &&
        request.resource.data.isBlacklisted == false &&
        request.resource.data.dtcBalance == 0;
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserCreate(userId);

      // Example rule set: owner can update their own profile, but never admin-only flags.
      // Admin can update any profile.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.isVerifiedBuyer == resource.data.isVerifiedBuyer &&
        request.resource.data.isBlacklisted == resource.data.isBlacklisted
      );
    }

    // DOCS
    match /docs/{ticker} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{txId} {
      allow read: if signedIn() && (
        isAdmin() ||
        request.auth.uid in resource.data.participants
      );

      // Users may create trade / buyout / transfer requests for themselves.
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;

      // Only admins may change a transaction after creation.
      allow update, delete: if isAdmin();
    }

    // ADMINS
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }
  }
}
